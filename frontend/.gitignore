/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# ===== 환경 변수 파일 무시 =====
# 모든 .env 파일 무시
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
.env.backup
*.env
**/.env
**/.env.*

# 환경 변수 관련 파일들
